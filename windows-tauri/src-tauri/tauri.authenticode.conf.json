{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "windows": {
      "signCommand": {
        "cmd": "pwsh",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-NonInteractive",
          "-File",
          "../../scripts/windows-authenticode.ps1",
          "-Mode",
          "Sign",
          "-Path",
          "%1"
        ]
      }
    }
  }
}
