{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LETSCUBE",
  "version": "0.2.0",
  "identifier": "ru.letscube.messenger",
  "build": {
    "frontendDist": "../ui",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "LETSCUBE",
        "url": "startup.html",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": true,
        "decorations": true,
        "resizable": true,
        "create": false,
        "dataDirectory": "webview-production-v1"
      }
    ],
    "security": {
      "capabilities": ["production", "startup"],
      "freezePrototype": true,
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEODBFNzJCREYyMUM4RDAKUldUUXlDSGZLK2VBN2Y5eHAvVm00bU1NM2FFMWpJZjlzMC85Rm1wUGFWWUg3cDRBY0RFeWx5VlAK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
