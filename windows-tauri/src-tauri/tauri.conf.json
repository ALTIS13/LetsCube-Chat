{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LETSCUBE",
  "version": "0.2.0",
  "identifier": "ru.letscube.messenger",
  "build": {
    "frontendDist": "../ui",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "splash",
        "title": "LETSCUBE",
        "url": "splash.html",
        "width": 460,
        "height": 300,
        "center": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "capabilities": ["production", "splash"],
      "freezePrototype": true,
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
