{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#bot/*": "./src/bot/*.ts"
  },
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "start:bot": "node --enable-source-maps ./dist/botGatewayIndex.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:registration-cleanup": "node --test ../../tests/unit/registration-cleanup-rules.test.mts ../../tests/unit/registration-cleanup-worker-contract.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "imapflow": "1.5.0",
    "mailparser": "3.9.13",
    "nodemailer": "9.0.3",
    "pino": "^9",
    "pino-http": "^10",
    "sharp": "^0.35.2",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mailparser": "3.4.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "7.0.4",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
