# Environment files. Keep only safe templates in git.
.ops-private/
.env
.env.*
!.env.example
!.env.production.example
!**/.env.example
!**/.env.production.example

# Dependencies.
node_modules/
**/node_modules/

# Build outputs.
dist/
build/
out/
out-tsc/
.next/
**/dist/
**/build/
*.tsbuildinfo

# Logs.
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Replit and generated local state.
.replit
.replitignore
replit.md
**/.replit
**/.replit-artifact/
.local/
.agents/
.cache/
.config/
.upm/
.breakpoints

