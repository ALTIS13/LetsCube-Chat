# Android release credentials and generated delivery artifacts are local only.
android/app/build/outputs/apk/release/
android/app/build/outputs/bundle/release/

# Standalone Tauri/Rust outputs. Source and Cargo.lock stay tracked.
windows-tauri/node_modules/
windows-tauri/src-tauri/target/
windows-tauri/src-tauri/gen/

# Local isolated implementation worktrees.
.worktrees/
