# KUB local development environment.
# Copy this file to .env and fill in your own values.
# Never commit real .env files.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_AUTH_CAPTCHA_PROVIDER=
VITE_AUTH_CAPTCHA_SITE_KEY=
VITE_AUTH_GATEWAY_URL=

# Optional local worker values. Leave empty for normal frontend development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SELFHOST_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@example.com
MEDIA_VARIANTS_WORKER_ENABLED=0
MEDIA_VARIANTS_WORKER_TICK_MS=60000

BASE_PATH=/
PORT=5173
KUB_WEB_PORT=8080
