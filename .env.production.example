# KUB production environment template.
# Copy this file to a local .env file on the target machine.
# Keep real values outside git.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_AUTH_CAPTCHA_PROVIDER=
VITE_AUTH_CAPTCHA_SITE_KEY=
VITE_AUTH_GATEWAY_URL=

# Optional private runtime values for kub-worker only.
# Never pass these as Vite build args or commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SELFHOST_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@example.com
MEDIA_VARIANTS_WORKER_ENABLED=1
MEDIA_VARIANTS_WORKER_TICK_MS=60000

BASE_PATH=/
PORT=5173
KUB_WEB_PORT=8080
