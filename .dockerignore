# Applies to Docker builds whose context is the repo root.
# Main deployment build:
#   docker build -f docs/deploy/Dockerfile .

**/node_modules
**/dist
**/build
**/.next
**/.turbo
**/.cache
**/target
*.tsbuildinfo

.git
.gitignore
.github

# Private operations and local state.
.ops-private
**/.ops-private
.ops-local
**/.ops-local
.superpowers
docs/superpowers
**/review-artifacts
**/review_artifacts

# Replit and local state.
.local
.agents
.replit
.replitignore
replit.md
**/.replit
**/.replit-artifact
.config
.cache
.upm
.breakpoints
attached_assets
.playwright-mcp
.qa-screenshots
playwright-report
test-results
output
coverage
.nyc_output

# Backup and database evidence must never enter a build context.
**/backups
**/backup
**/*.dump
**/*.dump.*
**/*.sql.gz
**/SHA256SUMS
**/MANIFEST.txt

# SQL migration source backup is not needed in the web image.
.migration-backup

# Editor and OS noise.
.vscode
.idea
*.log
*.tmp
*.temp
*.bak
*.backup
.DS_Store
Thumbs.db

# Environment files must never end up in any Docker layer.
.env
.env.*
**/.env
**/.env.*
*.env
*.env.*

# Private keys, signing stores and mobile service configuration.
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.der
**/*.cer
**/*.crt
**/*.sig
**/*.asc
**/*.mobileprovision
**/*.provisionprofile
**/id_rsa
**/id_rsa.*
**/id_ed25519
**/id_ed25519.*
**/signing
**/.signing
**/*signing*
**/google-services.json
**/GoogleService-Info.plist
